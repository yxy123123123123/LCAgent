{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcagent.local/contracts/goal/observation_plan.schema.json",
  "title": "LCAgent ObservationPlan",
  "type": "object",
  "required": [
    "plan_id",
    "version",
    "goal_id",
    "goal_hash",
    "queries",
    "evidence_requirements",
    "required_completeness"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^observation_[a-f0-9]{16}$"},
    "version": {"const": "1.0"},
    "goal_id": {"type": "string", "pattern": "^goal_[A-Za-z0-9_-]+$"},
    "goal_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query_id", "filter", "fields", "page_size"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^query_[a-f0-9]{12}$"},
          "filter": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "actor_guid": {"type": "string"},
              "actor_name": {"type": "string"},
              "class_name": {"type": "string"},
              "asset_reference": {"type": "string"},
              "level_id": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "page_size": {"type": "integer", "minimum": 1, "maximum": 1000}
        },
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["constraint_id", "entity_id", "required_fields"],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1},
          "entity_id": {"type": "string", "minLength": 1},
          "required_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "required_completeness": {
      "type": "object",
      "required": ["allow_truncated", "required_fields"],
      "properties": {
        "allow_truncated": {"const": false},
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
