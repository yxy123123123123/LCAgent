{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcagent.local/contracts/scene/scene_diff.schema.json",
  "title": "LCAgent SceneDiff",
  "type": "object",
  "required": ["diff_id", "before_snapshot_id", "after_snapshot_id", "status", "reasons", "added_entities", "removed_entities", "modified_entities"],
  "properties": {
    "diff_id": {"type": "string", "pattern": "^diff_[a-f0-9]{16}$"},
    "before_snapshot_id": {"type": "string", "pattern": "^snapshot_[a-f0-9]{16}$"},
    "after_snapshot_id": {"type": "string", "pattern": "^snapshot_[a-f0-9]{16}$"},
    "status": {"enum": ["comparable", "inconclusive"]},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "added_entities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "removed_entities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "modified_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "changes"],
        "properties": {
          "entity_id": {"type": "string"},
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "before", "after"],
              "properties": {
                "path": {"type": "string"},
                "before": {},
                "after": {},
                "delta": {"type": "number"},
                "tolerance": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
